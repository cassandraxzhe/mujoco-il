<mujoco model="hopper">
    <compiler angle="degree" coordinate="local" autolimits="true"/>
    <option gravity="0 0 -9.81" timestep="0.0001" integrator="RK4" cone="elliptic"/> <!-- friction cone-->
    <!--o_-->

    <default>
        <geom type="box" rgba="0.8 0.4 0.4 1"/>
        <motor ctrllimited="true" ctrlrange="0 0.0035"/>
    </default>

    <worldbody>
        <camera name="camera-1" pos="0 0 1"/>
        <camera name="track" mode="trackcom" pos="0 -0.1 0.3"/>

        <light name="top" pos="0 0 1"/>
        <geom name="floor" type="plane" size="1 1 0.1" rgba="0.2 0.3 0.4 1"/>

        <body name="hopper" pos="0 0 0.035">  <!-- 3.5 cm, foot ~0.5 cm above z=0 -->
            <freejoint/>
            <inertial pos="0 0 0" mass="0.00095" diaginertia="6.0e-08 6.0e-08 7.5e-08"/>

            <!-- sites for wing thrusters -->
            <site name="wing1" pos="0.015 0.015 0" size="0.001" rgba="1 0 0 1"/>
            <site name="wing2" pos="0.015 -0.015 0" size="0.001" rgba="0 1 0 1"/>
            <site name="wing3" pos="-0.015 0.015 0" size="0.001" rgba="0 0 1 1"/>
            <site name="wing4" pos="-0.015 -0.015 0" size="0.001" rgba="1 1 0 1"/>

            <!-- torso -->
            <!-- <geom name="hopper-torso" type="box" size="0.015 0.015 0.005"
                  mass="0.00095" friction="0.8 0.1 0.01"/> -->
            <geom name="hopper-torso" type="box" size="0.015 0.015 0.005"
                mass="0.00095" friction="0.8 0.1 0.01"
                contype="1" conaffinity="1"/>

            <!-- leg -->
            <body name="hopper-leg" pos="0 0 -0.03">
                <!-- <joint name="hopper-slide" type="slide" axis="0 0 1" damping="0.01"/> -->
                <!-- <joint name="hopper-slide" type="slide" axis="0 0 1"
                    springref="0" damping="0.01" frictionloss="0"/> -->
                <joint name="hopper-slide" type="slide" axis="0 0 1"
                    range="-0.03 0.0" springref="0" damping="0.01"
                    solreflimit="0.001 1"
                    solimplimit="0.99 0.999 0.0001 0.5 2"/>
                <!--solref-->
                <!-- <geom name="leg" type="capsule" fromto="0 0 0 0 0 -0.03"
                      size="0.002" mass="0.00003" friction="1.0 0.1 0.01"/> -->
                <geom name="leg" type="capsule" fromto="0 0 0 0 0 -0.03"
                    size="0.002" mass="0.00003"
                    contype="1" conaffinity="1" solref="-2000 -8.0" solimp="0.9 0.9 0.01"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Springy leg actuator -->
        <!-- <general name="leg-spring" joint="hopper-slide"
                gainprm="70" biastype="affine" biasprm="0 0 0 0 0 0"
                ctrllimited="false"/> -->
        
        <!-- <general name="leg-spring" joint="hopper-slide"
         gainprm="0 0 0 0 0 0 70"   
         biastype="affine"
         biasprm="0 0 0 0 0 0"      
         ctrllimited="false"/> -->
        <motor name="leg-motor" joint="hopper-slide" gear="1.0" ctrlrange="0 1"/>

        <!-- Wings -->
        <general name="f1" site="wing1" gear="0 0 1" forcerange="0 0.003"
                ctrllimited="true" ctrlrange="0 0.003"/>
        <general name="f2" site="wing2" gear="0 0 1" forcerange="0 0.003"
                ctrllimited="true" ctrlrange="0 0.003"/>
        <general name="f3" site="wing3" gear="0 0 1" forcerange="0 0.003"
                ctrllimited="true" ctrlrange="0 0.003"/>
        <general name="f4" site="wing4" gear="0 0 1" forcerange="0 0.003"
                ctrllimited="true" ctrlrange="0 0.003"/>
    </actuator>
</mujoco>

